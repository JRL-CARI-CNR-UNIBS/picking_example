<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>picking_example</name>
  <version>0.2.0</version>
  <description>Pick and place example in the Sharework cell (Gazebo): YOLO detection, scene_db, VGN grasps, parallel_multigoal_planner, place in a basket.</description>
  <maintainer email="manuel.beschi@unibs.it">manuel beschi</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>ik_solver_msgs</exec_depend>
  <exec_depend>parallel_multigoal_planner_msgs</exec_depend>
  <exec_depend>time_parametrization_msgs</exec_depend>
  <exec_depend>scene_msgs</exec_depend>
  <exec_depend>gz_transport_vendor</exec_depend>
  <exec_depend>gz_msgs_vendor</exec_depend>

  <!-- Simulation and services started by the launch files -->
  <exec_depend>sharework_gazebo</exec_depend>
  <exec_depend>sharework_cembre_moveit_config</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ik_solver</exec_depend>
  <exec_depend>ur_ik_solver</exec_depend>
  <exec_depend>collision_checker_server</exec_depend>
  <exec_depend>parallel_multigoal_planner</exec_depend>
  <exec_depend>time_parametrization</exec_depend>
  <exec_depend>scene_db</exec_depend>
  <exec_depend>yolo_rgbd_detector</exec_depend>
  <!-- vgn_grasp_server runs in the robostack environment (ros2_robostack_ws) -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
