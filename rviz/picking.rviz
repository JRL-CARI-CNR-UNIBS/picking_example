# RViz configuration of picking_example: MoveIt scene, scene_db objects,
# VGN grasps, wrist camera and YOLO detections.
Panels:
- Class: rviz_common/Displays
  Name: Displays
  Help Height: 0
  Property Tree Widget:
    Expanded: []
    Splitter Ratio: 0.5
  Tree Height: 300
Visualization Manager:
  Class: ''
  Name: root
  Enabled: true
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 0.5
    Plane Cell Count: 10
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: moveit_rviz_plugin/PlanningScene
    Name: PlanningScene
    Enabled: true
    Move Group Namespace: ''
    Planning Scene Topic: /monitored_planning_scene
    Robot Description: robot_description
    Scene Geometry:
      Scene Alpha: 0.6
      Scene Color: 50; 230; 50
      Scene Display Time: 0.01
      Show Scene Geometry: true
      Voxel Coloring: Z-Axis
      Voxel Rendering: Occupied Voxels
    Scene Robot:
      Attached Body Color: 150; 50; 150
      Robot Alpha: 1.0
      Show Robot Collision: false
      Show Robot Visual: true
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Name: scene_db objects
    Enabled: true
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /scene_db/markers
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Name: YOLO boxes
    Enabled: false
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /yolo_rgbd_detector/markers
    Value: false
  - Class: rviz_default_plugins/MarkerArray
    Name: VGN grasps
    Enabled: true
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /vgn_grasp_server/grasp_markers
    Value: true
  - Class: rviz_default_plugins/Image
    Name: Wrist camera
    Enabled: true
    Normalize Range: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /wrist/color/image_raw
    Value: true
  - Class: rviz_default_plugins/Image
    Name: YOLO detections
    Enabled: true
    Normalize Range: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /yolo_rgbd_detector/debug_image
    Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 2.6
      Focal Point:
        X: 0.3
        Y: 0.05
        Z: 1.1
      Pitch: 0.55
      Yaw: 3.6
      Target Frame: <Fixed Frame>
      Near Clip Distance: 0.01
      Value: Orbit (rviz)
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1500
  Hide Left Dock: false
  Hide Right Dock: true
  X: 0
  Y: 0
